{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "chatads.brief@1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "business",
    "offer",
    "customer",
    "goal",
    "market",
    "landing_url",
    "spend_limit",
    "measurement",
    "evidence",
    "open_questions"
  ],
  "properties": {
    "contract_name": {
      "const": "chatads.brief"
    },
    "contract_version": {
      "const": "1.0"
    },
    "business": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "offer": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "customer": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "goal": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "market": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "landing_url": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https?://[^\\s/?#@]+(?::[0-9]+)?(?:/[^\\s?#]*)?$"
    },
    "spend_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "amount",
        "period_days"
      ],
      "properties": {
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "period_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "measurement": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "source"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
